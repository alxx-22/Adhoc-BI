// ============================================================================
// New MEASURES for 'App Summarised table'
// ----------------------------------------------------------------------------
// These translate the "Feedback Progress breakdown" DAX query into two PACKED
// values the Power App can read the same way it reads its other packs
// (First(PowerBIIntegration.Data).'<name>', then Split on " || " / " // ").
//
// Grain / consumers:
//   'FP Detail Pack'      — one record per Feedback Progress (rep)  -> FLM page
//   'Manager Detail Pack' — one record per Manager entitlement      -> Exec page
//
// Each record packs:  Tracked OS $, Untracked OS $, and the count of UNTRACKED
// opportunities of each target type (CC / Day 1 Upsell, Low Pen Rate,
// No Services Op) — i.e. "how much is covered, and what still needs action".
//
// *** IMPORTANT: create each of these as a MEASURE, not a calculated column. ***
//   A calculated column is computed once at refresh and is STATIC at query time,
//   so it can never respond to a report filter, page filter or slicer. An earlier
//   revision shipped these as calculated columns wrapped in ALL('App Summarised
//   table'); the result was that the FLM feedback-progress breakdown ignored a
//   report filter on [Entitled Manager Name] (and did not honour RLS the way a
//   measure does). Defining them as measures — the same as the app's other packs —
//   makes them respond to report/page filters and RLS again.
//
// Why ALLSELECTED (not ALL):
//   * ALL('App Summarised table') strips EVERY filter, including the manager-name
//     report filter and RLS — that is exactly what broke the dynamic filtering.
//   * ALLSELECTED('App Summarised table') removes only the Power Apps visual's own
//     internal grouping, while KEEPING the report/page/slicer filters and RLS. So:
//       - with no filter applied, an FLM sees their whole team (RLS-scoped);
//       - a report filter on [Entitled Manager Name] narrows the breakdown to that
//         manager's reps, live, exactly as before;
//       - the exec's 'Manager Detail Pack' likewise narrows when a manager filter
//         is applied, and shows every manager otherwise.
//
// Notes vs your EVALUATE query:
//   * Aggregated at the App Summarised (opportunity) grain using [Services OS]
//     (the app's OS value everywhere) and the app's tracked rule
//     ([App tracking] = "Y" || [Is Alternate Opp] = "Y") — so the numbers match
//     the rest of the app's cards. Scoped to FQ IN {"FY2026 Q4","FY2027 Q1"}
//     exactly as in your query.
//   * If you need the exact Final-Output / OS-line semantics of the query
//     instead of the opportunity-grain [Services OS], say so and I'll swap the
//     aggregation source; the packed string format stays the same.
//
// The packed-string format is unchanged, so NO change is needed in the app:
// the FLM/Exec OnVisible parses (colFPDetail / colMgrDetail) read them as before.
//
// HOW TO ADD: create each block below as a MEASURE on 'App Summarised table'
// (Tabular Editor: New Measure, paste the expression; or add the `measure` block
// to the table in the .tmdl), refresh, then republish so PowerBIIntegration.Data
// exposes the two new fields to the Power Apps visual. Keep the pack fields as the
// only fields in that visual (no grouping column), same as your existing packs, so
// First(PowerBIIntegration.Data) returns one row holding the complete packed string.
// ============================================================================


// ---- Rep-level (Feedback Progress) — feeds the FLM page --------------------
measure 'FP Detail Pack' =
        CONCATENATEX(
            ADDCOLUMNS(
                SUMMARIZE(
                    FILTER(
                        ALLSELECTED('App Summarised table'),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" }
                    ),
                    'App Summarised table'[Feedback Progress]
                ),
                "TSum",
                    CALCULATE(
                        SUM('App Summarised table'[Services OS]),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" },
                        ( 'App Summarised table'[App tracking] = "Y" || 'App Summarised table'[Is Alternate Opp] = "Y" )
                    ),
                "USum",
                    CALCULATE(
                        SUM('App Summarised table'[Services OS]),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" },
                        'App Summarised table'[App tracking] <> "Y",
                        'App Summarised table'[Is Alternate Opp] <> "Y"
                    ),
                "CC",
                    CALCULATE(
                        COUNTROWS('App Summarised table'),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" },
                        'App Summarised table'[App tracking] <> "Y",
                        'App Summarised table'[Is Alternate Opp] <> "Y",
                        'App Summarised table'[Target Opp?] = "CC / Day 1 Upsell"
                    ),
                "LP",
                    CALCULATE(
                        COUNTROWS('App Summarised table'),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" },
                        'App Summarised table'[App tracking] <> "Y",
                        'App Summarised table'[Is Alternate Opp] <> "Y",
                        'App Summarised table'[Target Opp?] = "Low Pen Rate"
                    ),
                "NS",
                    CALCULATE(
                        COUNTROWS('App Summarised table'),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" },
                        'App Summarised table'[App tracking] <> "Y",
                        'App Summarised table'[Is Alternate Opp] <> "Y",
                        'App Summarised table'[Target Opp?] = "No Services Op"
                    )
            ),
            'App Summarised table'[Feedback Progress]
                & " // " & IF([TSum] = BLANK(), 0, [TSum])
                & " // " & IF([USum] = BLANK(), 0, [USum])
                & " // " & [CC]
                & " // " & [LP]
                & " // " & [NS],
            " || "
        )
        lineageTag: a1f4b0c2-1111-4a10-9b20-fp0000000001


// ---- Manager-level (Manager entitlement) — feeds the Exec page -------------
measure 'Manager Detail Pack' =
        CONCATENATEX(
            ADDCOLUMNS(
                SUMMARIZE(
                    FILTER(
                        ALLSELECTED('App Summarised table'),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" }
                            && 'App Summarised table'[Manager entitlement] <> ""
                    ),
                    'App Summarised table'[Manager entitlement],
                    'App Summarised table'[Entitled Manager Name]
                ),
                "TSum",
                    CALCULATE(
                        SUM('App Summarised table'[Services OS]),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" },
                        ( 'App Summarised table'[App tracking] = "Y" || 'App Summarised table'[Is Alternate Opp] = "Y" )
                    ),
                "USum",
                    CALCULATE(
                        SUM('App Summarised table'[Services OS]),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" },
                        'App Summarised table'[App tracking] <> "Y",
                        'App Summarised table'[Is Alternate Opp] <> "Y"
                    ),
                "CC",
                    CALCULATE(
                        COUNTROWS('App Summarised table'),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" },
                        'App Summarised table'[App tracking] <> "Y",
                        'App Summarised table'[Is Alternate Opp] <> "Y",
                        'App Summarised table'[Target Opp?] = "CC / Day 1 Upsell"
                    ),
                "LP",
                    CALCULATE(
                        COUNTROWS('App Summarised table'),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" },
                        'App Summarised table'[App tracking] <> "Y",
                        'App Summarised table'[Is Alternate Opp] <> "Y",
                        'App Summarised table'[Target Opp?] = "Low Pen Rate"
                    ),
                "NS",
                    CALCULATE(
                        COUNTROWS('App Summarised table'),
                        'App Summarised table'[FQ] IN { "FY2026 Q4", "FY2027 Q1" },
                        'App Summarised table'[App tracking] <> "Y",
                        'App Summarised table'[Is Alternate Opp] <> "Y",
                        'App Summarised table'[Target Opp?] = "No Services Op"
                    )
            ),
            'App Summarised table'[Manager entitlement]
                & " // " & 'App Summarised table'[Entitled Manager Name]
                & " // " & IF([TSum] = BLANK(), 0, [TSum])
                & " // " & IF([USum] = BLANK(), 0, [USum])
                & " // " & [CC]
                & " // " & [LP]
                & " // " & [NS],
            " || "
        )
        lineageTag: b2e5c1d3-2222-4b21-8c31-mgr000000001
